# ====================================================================
# FindCollege.ai — Environment Configuration Template (.env.example)
# ====================================================================
# Copy this file to .dev.vars for local testing with Wrangler:
#   npx wrangler pages dev . --d1 DB=findcollege_courses_db
# In production, set these secrets in Cloudflare Dashboard:
#   Pages Project > Settings > Environment Variables
# ====================================================================

# 1. RAZORPAY PAYMENT GATEWAY
# Get keys from Razorpay Dashboard > Settings > API Keys
# For Sandbox Testing: use keys starting with rzp_test_
# For Production: use keys starting with rzp_live_
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere

# Razorpay Webhook Secret (Set when adding webhook at https://yourdomain.com/api/razorpay-webhook)
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# 2. RESEND TRANSACTIONAL EMAIL SERVICE
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=re_YourResendApiKeyHere
EMAIL_FROM=FindCollege.ai <onboarding@resend.dev>
SUPPORT_EMAIL=support@findcollege.ai

# 3. ADMIN AUTHENTICATION
# The Admin Portal only asks for a password. Default is: FindCollege#2026
ADMIN_PASSWORD=FindCollege#2026
ADMIN_JWT_SECRET=super_secret_random_64_char_signing_key_here

# 4. META PIXEL TRACKING
# Your Meta Pixel ID from Meta Events Manager (Numbers only)
META_PIXEL_ID=1064251043037583
# Optional: Meta Conversions API Access Token
META_CONVERSIONS_API_TOKEN=EAAd3u9VvMS0BS5PZBCzC9XZC1wLZCRhKql7M8gRAPkY4R7ZCLIm9NczPqoVOtOW2PuBHsHuW5OjTJxpPZCmfhjkDGebUmgJJRmrOGJZBaZBJIpByomwIM78OobfijluATw29LeArczctpfamujmELnENQ6KC72w4deoprB1Mwk3o8cOYZCZAiKmc3LZCUO9YCS5mnZBQQZDZD

# 5. GENERAL CONFIGURATION
COMPANY_NAME=FINDCOLLEGE.AI
APP_URL=https://course.findcollege.ai
CURRENCY=INR

